<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Start GZ or Ignition depending on ROS 2 Version -->
  <xacro:arg name="is_ignition" default="true"/>

  <!-- Include Gazebo Parameters -->
  <xacro:include filename="$(find robot_description)/urdf/robot_gazebo.xacro" />

  <!-- Include ros2_control Plugins -->
  <xacro:include filename="$(find robot_description)/urdf/robot_ros2_control.xacro" />
  <link name="base_footprint"></link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.0301" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/warehouse_body.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="base_link-material">
        <color rgba="0.7304607400847158 0.9734452903978066 0.9301108583738498 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/warehouse_body.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_left_a" type="continuous">
    <parent link="base_link" />
    <child link="wheel_left_a" />
    <origin xyz="0.24897296844509964 -0.2048408988627613 0.00029176643789720347" rpy="0 1.5707963267948966 0" />
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <link name="wheel_left_a">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
      <material name="wheel_left_a-material">
        <color rgba="0.2917706498067337 0.0069954101845983935 0.22322795730611386 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_left_b" type="continuous">
    <parent link="base_link" />
    <child link="wheel_left_b" />
    <origin xyz="0.24897296844509964 0.2 0.00029176643789720347" rpy="0 1.5707963267948966 0" />
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <link name="wheel_left_b">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
      <material name="wheel_left_b-material">
        <color rgba="0.2917706498067337 0.0069954101845983935 0.22322795730611386 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_right_a" type="continuous">
    <parent link="base_link" />
    <child link="wheel_right_a" />
    <origin xyz="-0.24829607817936983 -0.2040222210664107 0.0019737372441050276" rpy="0 1.5707963267948966 0" />
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <link name="wheel_right_a">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
      <material name="wheel_right_a-material">
        <color rgba="0.2917706498067337 0.0069954101845983935 0.22322795730611386 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_right_b" type="continuous">
    <parent link="base_link" />
    <child link="wheel_right_b" />
    <origin xyz="-0.25 0.2 0.0019737372441050276" rpy="0 1.5707963267948966 0" />
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <link name="wheel_right_b">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
      <material name="wheel_right_b-material">
        <color rgba="0.2917706498067337 0.0069954101845983935 0.22322795730611386 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0381" length="0.0381" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.04976854312086337" rpy="0 0 0" />
  </joint>
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.034 0.048 0.016" />
      </geometry>
      <material name="imu_link-material">
        <color rgba="0.1878207722902346 0.2663556047920505 0.8879231178794776 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.034 0.048 0.016" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00552433659106688 0.000168210391520346 0.000514000497342681" rpy="0 0 0" />
      <mass value="0.000528415362211671" />
      <inertia ixx="1.46176048428261E-08" ixy="1.40015117949421E-10" ixz="-1.99633872937403E-12"
               iyy="8.59662482954888E-09" iyz="7.52375112767959E-12"
               izz="2.30279421279312E-08" />
    </inertial>
      </link>
  <joint name="base_link_to_cylinder1" type="fixed">
    <parent link="base_link" />
    <child link="cylinder1" />
    <origin xyz="0 0.2743596211552094 0.17187495060830255" rpy="0 0 0" />
  </joint>
  <link name="cylinder1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.25" />
      </geometry>
      <material name="cylinder1-material">
        <color rgba="0.13843161502267545 0.22696587349938613 0.5906188409113381 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.25" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_lidar_link1" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link1" />
    <origin xyz="0 0.26905406686894473 0.29644575463716955" rpy="0 0 0" />
  </joint>
  <link name="lidar_link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0494" length="0.035" />
      </geometry>
      <material name="lidar_link1-material">
        <color rgba="0.29613827078752575 0.29613827078752575 0.29613827078752575 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0494" length="0.035" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.017" />
      <inertia ixx="0.005666666666666667" ixy="0" ixz="0" iyy="0.0085" iyz="0" izz="0.005666666666666667" />
    </inertial>

        <sensor type="lidar" name="lidar">
            <always_on>true</always_on>
            <update_rate>5</update_rate>
            <origin>0 0.26905406686894473 0.29644575463716955 0 0 0</origin>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.28</max_angle>
                    </horizontal>
                    <range>
                        <min>0.12</min>
                        <max>12</max>
                        <resolution>0.015</resolution>
                    </range>
                </scan>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
      </link>
</robot>